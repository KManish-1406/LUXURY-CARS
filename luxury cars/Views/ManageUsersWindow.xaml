<Window x:Class="luxury_cars.Views.ManageUsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Users"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme_BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <Border Grid.Row="0" Background="{DynamicResource Theme_TopBarBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="22" FontFamily="Segoe UI Emoji"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Manage Users"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Add User"
                        Height="34" Padding="16,0"
                        FontSize="12" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="AddUserBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{DynamicResource Theme_AccentBrush}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Users DataGrid -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme_SurfaceBrush}"
                CornerRadius="12" Margin="24,16,24,0"
                BorderBrush="{DynamicResource Theme_BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid x:Name="UsersGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="{DynamicResource Theme_SurfaceBrush}"
                      RowBackground="{DynamicResource Theme_GridRowBrush}"
                      AlternatingRowBackground="{DynamicResource Theme_GridAltRowBrush}"
                      ColumnHeaderHeight="44" RowHeight="48"
                      FontSize="13"
                      Foreground="{DynamicResource Theme_TextBrush}"
                      SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="{DynamicResource Theme_GridHeaderBrush}"/>
                        <Setter Property="Foreground"      Value="{DynamicResource Theme_MutedTextBrush}"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource Theme_BorderBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"       Binding="{Binding Id}"      Width="60"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="200"/>
                    <DataGridTextColumn Header="Role"     Binding="{Binding RoleName}" Width="150"/>

                    <!-- Change Role -->
                    <DataGridTemplateColumn Header="Change Role" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox x:Name="RoleCombo"
                                          Height="30" Margin="4,0"
                                          FontSize="12"
                                          Tag="{Binding Id}"
                                          SelectionChanged="RoleCombo_SelectionChanged">
                                    <ComboBoxItem Content="Admin"/>
                                    <ComboBoxItem Content="Manager"/>
                                    <ComboBoxItem Content="Salesperson"/>
                                    <ComboBoxItem Content="Viewer"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Delete -->
                    <DataGridTemplateColumn Header="Delete" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Tag="{Binding Id}"
                                        Height="28" Padding="8,0"
                                        FontSize="11" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="DeleteUserBtn_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    Background="#EF4444"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="StatusText"
                   FontSize="12"
                   Foreground="{DynamicResource Theme_MutedTextBrush}"
                   Margin="24,10,24,16"/>
    </Grid>
</Window>

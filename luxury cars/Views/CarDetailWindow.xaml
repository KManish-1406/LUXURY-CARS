<Window x:Class="luxury_cars.Views.CarDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:luxury_cars.Converters"
        Title="Car Details"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F0F1A">

	<Window.Resources>
		<conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<!-- Full image area -->
			<RowDefinition Height="Auto"/>
			<!-- Details strip at bottom -->
		</Grid.RowDefinitions>

		<!-- ══════════════════════════════════════════ -->
		<!--  FULL IMAGE — takes entire top area        -->
		<!-- ══════════════════════════════════════════ -->
		<Grid Grid.Row="0">

			<!-- Car image — full width, full height -->
			<Image Source="{Binding Car.FullImagePath}"
                   Stretch="UniformToFill"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Visibility="{Binding Car.HasImage,
                       Converter={StaticResource BoolToVis}}"/>

			<!-- Placeholder when no image -->
			<StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding Car.HasImage,
                            Converter={StaticResource BoolToVis},
                            ConverterParameter=Inverse}">
				<TextBlock Text="🚗" FontSize="120"
                           FontFamily="Segoe UI Emoji"
                           HorizontalAlignment="Center"/>
				<TextBlock Text="No Image Uploaded"
                           FontSize="16" Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
			</StackPanel>

			<!-- Dark gradient from bottom — so text is readable -->
			<Border VerticalAlignment="Bottom" Height="220">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="Transparent"    Offset="0"/>
						<GradientStop Color="#DD0F0F1A"      Offset="0.6"/>
						<GradientStop Color="#FF0F0F1A"      Offset="1"/>
					</LinearGradientBrush>
				</Border.Background>
			</Border>

			<!-- Status badge — top left -->
			<Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20,20,0,0"
                    CornerRadius="6" Padding="12,5">
				<Border.Style>
					<Style TargetType="Border">
						<Setter Property="Background" Value="#22C55E"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding Car.Status}"
                                         Value="Out of Stock">
								<Setter Property="Background" Value="#EF4444"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<TextBlock Text="{Binding Car.Status}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="White"/>
			</Border>

			<!-- Close button — top right -->
			<Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Width="36" Height="36"
                    Content="✕" FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseBtn_Click">
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd"
                                Background="#44000000"
                                CornerRadius="18">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#88000000"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Button.Template>
			</Button>

			<!-- Car name overlay — bottom left of image -->
			<StackPanel VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="28,0,0,28">
				<TextBlock Text="{Binding Car.Brand}"
                           FontSize="14" Foreground="#94A3B8"
                           FontWeight="SemiBold"/>
				<TextBlock Text="{Binding Car.Name}"
                           FontSize="36" Foreground="White"
                           FontWeight="Bold"/>
				<TextBlock Text="{Binding Car.Year}"
                           FontSize="14" Foreground="#94A3B8"/>
			</StackPanel>

			<!-- Price + Sell button — bottom right of image -->
			<StackPanel VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,0,28,24">
				<TextBlock Text="{Binding Car.PriceDisplay}"
                           FontSize="30" FontWeight="Bold"
                           Foreground="DeepPink"
                           HorizontalAlignment="Right"/>
				<TextBlock Text="Ex-showroom price"
                           FontSize="11" Foreground="#64748B"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,12"/>
				<Button Content="💰  Sell This Car"
                        Height="44" Padding="24,0"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="SellBtn_Click"
                        IsEnabled="{Binding CanSell}"
                        HorizontalAlignment="Right">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="bd" Background="#22C55E"
                                    CornerRadius="10">
								<ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="bd" Property="Opacity" Value="0.85"/>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="bd" Property="Background" Value="#475569"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</StackPanel>
		</Grid>

		<!-- ══════════════════════════════════════════ -->
		<!--  SPECS STRIP — dark bar at bottom          -->
		<!-- ══════════════════════════════════════════ -->
		<Border Grid.Row="1" Background="#16162A"
                Padding="28,16">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<!-- Model No -->
				<StackPanel Grid.Column="0">
					<TextBlock Text="MODEL NO." FontSize="10"
                               Foreground="#475569" FontWeight="Bold"/>
					<TextBlock Text="{Binding Car.ModelNumber}"
                               FontSize="13" Foreground="White"
                               FontWeight="SemiBold" Margin="0,3,0,0"/>
				</StackPanel>

				<!-- Color -->
				<StackPanel Grid.Column="1">
					<TextBlock Text="COLOR" FontSize="10"
                               Foreground="#475569" FontWeight="Bold"/>
					<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
						<Border Width="14" Height="14" CornerRadius="7"
                                Margin="0,0,6,0" VerticalAlignment="Center">
							<Border.Background>
								<SolidColorBrush Color="{Binding CarColorBrush}"/>
							</Border.Background>
						</Border>
						<TextBlock Text="{Binding Car.Color}"
                                   FontSize="13" Foreground="White"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</StackPanel>

				<!-- Stock -->
				<StackPanel Grid.Column="2">
					<TextBlock Text="STOCK" FontSize="10"
                               Foreground="#475569" FontWeight="Bold"/>
					<TextBlock Text="{Binding Car.StockDisplay}"
                               FontSize="13" Foreground="White"
                               FontWeight="SemiBold" Margin="0,3,0,0"/>
				</StackPanel>

				<!-- Added On -->
				<StackPanel Grid.Column="3">
					<TextBlock Text="ADDED ON" FontSize="10"
                               Foreground="#475569" FontWeight="Bold"/>
					<TextBlock Text="{Binding Car.CreatedAt}"
                               FontSize="13" Foreground="White"
                               FontWeight="SemiBold" Margin="0,3,0,0"/>
				</StackPanel>

				<!-- Brand -->
				<StackPanel Grid.Column="4">
					<TextBlock Text="BRAND" FontSize="10"
                               Foreground="#475569" FontWeight="Bold"/>
					<TextBlock Text="{Binding Car.Brand}"
                               FontSize="13" Foreground="White"
                               FontWeight="SemiBold" Margin="0,3,0,0"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>

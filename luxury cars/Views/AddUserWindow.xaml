<Window x:Class="luxury_cars.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New User"
        Height="380" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme_BackgroundBrush}">

    <Grid VerticalAlignment="Center">
        <Border Background="{DynamicResource Theme_SurfaceBrush}"
                CornerRadius="16" Padding="36,30"
                Width="380" HorizontalAlignment="Center"
                BorderBrush="{DynamicResource Theme_BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#AAAAAA" BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Add New User"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Theme_PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_MutedTextBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameInput" Height="36"
                         Padding="10,0" FontSize="13"
                         BorderBrush="{DynamicResource Theme_BorderBrush}"
                         BorderThickness="1"
                         Background="{DynamicResource Theme_SurfaceBrush}"
                         Foreground="{DynamicResource Theme_TextBrush}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_MutedTextBrush}"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordInput" Height="36"
                             Padding="10,0" FontSize="13"
                             BorderBrush="{DynamicResource Theme_BorderBrush}"
                             BorderThickness="1"
                             Background="{DynamicResource Theme_SurfaceBrush}"
                             Foreground="{DynamicResource Theme_TextBrush}"
                             Margin="0,0,0,12"/>

                <!-- Role -->
                <TextBlock Text="Role" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme_MutedTextBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="RoleCombo" Height="36"
                          FontSize="13" Margin="0,0,0,16">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Manager" IsSelected="True"/>
                    <ComboBoxItem Content="Salesperson"/>
                    <ComboBoxItem Content="Viewer"/>
                </ComboBox>

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Foreground="#EF4444"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancel"
                            Height="40" FontSize="13"
                            Foreground="{DynamicResource Theme_PrimaryBrush}"
                            BorderThickness="1" Cursor="Hand"
                            Click="CancelBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource Theme_SurfaceBrush}"
                                        BorderBrush="{DynamicResource Theme_BorderBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="Add User"
                            Height="40" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="AddBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource Theme_ButtonBrush}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

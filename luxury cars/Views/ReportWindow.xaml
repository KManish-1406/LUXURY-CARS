<Window x:Class="luxury_cars.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sales Report — Luxury Cars"
        Height="750" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme_BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <Border Grid.Row="0" Background="{DynamicResource Theme_TopBarBrush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="22" FontFamily="Segoe UI Emoji"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Sales Report"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ExportPdfBtn" Content="⬇ Export PDF"
                            Height="34" Padding="16,0" Margin="0,0,10,0"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="ExportPdfBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#EF4444" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ExportExcelBtn" Content="⬇ Export Excel"
                            Height="34" Padding="16,0"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="ExportExcelBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#22C55E" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,16,24,0">
            <Button x:Name="BtnDaily" Content="Today"
                    Height="36" Padding="24,0" Margin="0,0,10,0"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="FilterBtn_Click" Tag="daily">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource Theme_ButtonBrush}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnWeekly" Content="This Week"
                    Height="36" Padding="24,0" Margin="0,0,10,0"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme_PrimaryBrush}"
                    Cursor="Hand" Click="FilterBtn_Click" Tag="weekly">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource Theme_SurfaceBrush}"
                                BorderBrush="{DynamicResource Theme_PrimaryBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnYearly" Content="This Year"
                    Height="36" Padding="24,0"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme_PrimaryBrush}"
                    Cursor="Hand" Click="FilterBtn_Click" Tag="yearly">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource Theme_SurfaceBrush}"
                                BorderBrush="{DynamicResource Theme_PrimaryBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Summary cards -->
        <Grid Grid.Row="2" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme_StatCardBrush}"
                    CornerRadius="12" Padding="16,14" Margin="0,0,10,0"
                    BorderBrush="{DynamicResource Theme_BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Sales" FontSize="12"
                               Foreground="{DynamicResource Theme_MutedTextBrush}"/>
                    <TextBlock x:Name="TotalSalesCount" Text="0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Theme_PrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme_StatCardBrush}"
                    CornerRadius="12" Padding="16,14" Margin="0,0,10,0"
                    BorderBrush="{DynamicResource Theme_BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Revenue" FontSize="12"
                               Foreground="{DynamicResource Theme_MutedTextBrush}"/>
                    <TextBlock x:Name="TotalRevenue" Text="₹0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#22C55E"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme_StatCardBrush}"
                    CornerRadius="12" Padding="16,14"
                    BorderBrush="{DynamicResource Theme_BorderBrush}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Due" FontSize="12"
                               Foreground="{DynamicResource Theme_MutedTextBrush}"/>
                    <TextBlock x:Name="TotalDue" Text="₹0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#EF4444"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="3"
                Background="{DynamicResource Theme_SurfaceBrush}"
                CornerRadius="12" Margin="24,14,24,24"
                BorderBrush="{DynamicResource Theme_BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#AAAAAA" BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
            </Border.Effect>
            <DataGrid x:Name="ReportGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="{DynamicResource Theme_SurfaceBrush}"
                      RowBackground="{DynamicResource Theme_GridRowBrush}"
                      AlternatingRowBackground="{DynamicResource Theme_GridAltRowBrush}"
                      ColumnHeaderHeight="44" RowHeight="44"
                      FontSize="12"
                      Foreground="{DynamicResource Theme_TextBrush}"
                      SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="{DynamicResource Theme_GridHeaderBrush}"/>
                        <Setter Property="Foreground"      Value="{DynamicResource Theme_MutedTextBrush}"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="FontSize"        Value="12"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource Theme_BorderBrush}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sale ID"    Binding="{Binding SaleIdDisplay}"     Width="80"/>
                    <DataGridTextColumn Header="Date"       Binding="{Binding SaleDate}"          Width="140"/>
                    <DataGridTextColumn Header="Customer"   Binding="{Binding CustomerName}"      Width="130"/>
                    <DataGridTextColumn Header="Phone"      Binding="{Binding CustomerPhone}"     Width="110"/>
                    <DataGridTextColumn Header="Brand"      Binding="{Binding Brand}"             Width="90"/>
                    <DataGridTextColumn Header="Model"      Binding="{Binding ModelNumber}"       Width="110"/>
                    <DataGridTextColumn Header="Payment"    Binding="{Binding PaymentType}"       Width="80"/>
                    <DataGridTextColumn Header="EMI"        Binding="{Binding EmiDisplay}"        Width="80"/>
                    <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePriceDisplay}"  Width="100"/>
                    <DataGridTextColumn Header="Paid"       Binding="{Binding AmountPaidDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Due"        Binding="{Binding DueAmountDisplay}"  Width="90"/>
                    <DataGridTextColumn Header="Delivery"   Binding="{Binding DeliveryDate}"      Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
